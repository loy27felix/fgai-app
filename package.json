{
  "name": "fg-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test tests/**/*.test.ts",
    "docker:config": "docker compose --env-file .env.docker config -q",
    "docker:ps": "docker compose --env-file .env.docker ps",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "logs:docker": "docker compose --env-file .env.docker logs --timestamps --follow --tail=200",
    "logs:app": "docker compose --env-file .env.docker logs --timestamps --follow --tail=200 app",
    "logs:app:history": "find \"$HOME/Library/Logs/fg-studio-app\" -type f -name '*.log' -print | sort",
    "logs:postgres": "docker compose --env-file .env.docker logs --timestamps --follow --tail=200 postgres",
    "logs:tunnel": "docker compose --env-file .env.docker logs --timestamps --follow --tail=200 cloudflared",
    "logs:nas": "tail -n 200 -F \"$HOME/Library/Logs/fg-studio-nas-supervisor.log\" \"$HOME/Library/Logs/fg-studio-nas-supervisor.error.log\"",
    "logs:deploy": "tail -n 200 -F \"$HOME/Library/Logs/fg-studio-auto-deploy.log\" \"$HOME/Library/Logs/fg-studio-auto-deploy.error.log\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "^2.8.10",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@tanstack/react-query": "^5.101.4",
    "@uiw/react-codemirror": "^4.25.11",
    "antd": "5.29.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.21",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "nanoid": "3.3.12",
    "next": "14.2.15",
    "ogl": "^1.0.11",
    "pg": "^8.13.1",
    "radix-ui": "^1.6.7",
    "rc-field-form": "^2.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  }
}
