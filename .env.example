# === Supabase ===（在 Supabase 项目 Settings → API 里找）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...你的_anon_public_key

# === DeepSeek ===（只放服务端，绝不要加 NEXT_PUBLIC_ 前缀）
DEEPSEEK_API_KEY=sk-你的_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 以后接 GPT 时再加：
# OPENAI_API_KEY=sk-...
