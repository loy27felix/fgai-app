POSTGRES_DB=fg_studio
POSTGRES_USER=fg_studio
POSTGRES_PASSWORD=replace-with-local-database-password
NAS_MEDIA_PATH=/Users/zhangyu/work/beva/mnt_nas_fg-studio-media
NAS_EXPECTED_HOST=192.168.0.14
NAS_EXPECTED_SHARE=FgStudio
NAS_READY_MARKER=.fg-studio-nas-ready
NAS_MOUNT_URL=smb://fgstudio@192.168.0.14/FgStudio
DATABASE_URL=postgres://fg_studio:replace-with-local-database-password@postgres:5432/fg_studio
LOCAL_MEDIA_URL=https://192.168.0.99:3000/api/local/storage/content
# Optional internal URL used only by server-side media proxies; production defaults to the Compose App service.
# 可选，仅供服务端媒体代理使用；生产环境默认走 Compose 的 App service。
# LOCAL_MEDIA_INTERNAL_URL=http://app:3000/api/local/storage/content
# Enable the Docker Nginx TLS profile on the production host.
# 在生产主机启用 Docker Nginx TLS profile；普通开发环境保持注释。
# COMPOSE_PROFILES=https
# FG_COMPOSE_PROFILE=https
# FG_APP_HOST_PORT=3001
# FG_NGINX_HOST_PORT=3000
# FG_NGINX_CERT_PATH=/Users/server/Downloads/192.168.0.99+1.pem
# FG_NGINX_KEY_PATH=/Users/server/Downloads/192.168.0.99+1-key.pem
# Public HTTPS URL from the Cloudflare Tunnel for Wetoken reference media.
# Cloudflare Tunnel 的公网 HTTPS 地址，供 Wetoken 下载参考素材。
PROVIDER_MEDIA_URL=
CLOUDFLARE_TUNNEL_TOKEN=
# Optional state-change alerts: generic, feishu, or wecom JSON webhook.
# 可选状态变化告警：支持 generic、飞书或企业微信 JSON webhook。
FG_MONITOR_WEBHOOK_URL=
FG_MONITOR_WEBHOOK_TYPE=generic
# Monitor connector readiness and public media reachability separately; never restart the tunnel.
# 分别监控 connector 就绪状态与公网媒体可达性，监控不会主动重启隧道。
# FG_MONITOR_TUNNEL_FAILURE_THRESHOLD=2
# FG_MONITOR_TUNNEL_PROBE_TIMEOUT_SECONDS=8
SESSION_SECRET=replace-with-random-secret
SESSION_COOKIE_SECURE=false
# Keep false until the Windows/macOS canary is signed off.
MEDIA_WORKER_ENABLED=false
# Path inside the App container to the release manifest mounted from NAS.
# Example: /data/media/worker-releases/manifest.json
FG_WORKER_RELEASE_MANIFEST_PATH=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
WETOKEN_API_KEY=
WETOKEN_BASE_URL=https://wetoken.ai/v1
# Optional override for Seedance asset-library requests; defaults to https://asset.wetoken.ai
# Seedance 素材库地址可选覆盖，默认使用 https://asset.wetoken.ai
WETOKEN_ASSET_BASE_URL=https://asset.wetoken.ai
# Volcengine Seed Audio 1.0 API key; keep this server-side and out of Git.
# 火山引擎 Seed Audio 1.0 API Key；只放服务端，禁止提交真实值。
VOLCENGINE_SEED_AUDIO_API_KEY=
USAGE_USD_TO_CNY_RATE=6.77
# Wetoken Seedance effective USD paid per CNY of official token usage. This
# default is calibrated from a 720p / 30s Seedance 2.5 invoice on 2026-09-10.
# Adjust only when this Wetoken account's token group or promotion changes.
NEXT_PUBLIC_WETOKEN_SEEDANCE_USD_PER_CNY=0.130109038801
# Internal report and monitor event authentication; generate a long random value.
# 内部报表与监控事件认证密钥；请生成足够长的随机值，禁止提交真实值。
FG_OBSERVABILITY_SECRET=
FG_OBSERVABILITY_URL=http://127.0.0.1:3001
# Optional report notification: generic, feishu, or wecom JSON webhook.
# 可选报表通知：支持 generic、飞书或企业微信 JSON webhook。
FG_REPORT_WEBHOOK_URL=
FG_REPORT_WEBHOOK_TYPE=generic

# === Feishu support bot / 飞书问题助手 ===
# Production template only; never copy production and local env files into each other.
# 仅供生产配置准备；本地与生产 env 不互拷，真实地址与密钥仅由对应环境注入。
# Production requires NODE_ENV=production, including host-run worker/check processes.
# 生产要求 NODE_ENV=production；宿主机 worker/check 不继承 Dockerfile 的环境。
NODE_ENV=production
SUPPORT_BOT_ENVIRONMENT=production
# Confirm each target DB before its owner sets the database-level GUC to production.
# 确认每个目标库后由 owner 设置数据库级 fg.support_environment=production；迁移不自动设置。
# Explicit opt-in; keep intake and delivery disabled until required sources are ready.
# 显式启用；所需证据源就绪前保持接收和外发关闭，本地环境禁止飞书外发。
SUPPORT_BOT_ENABLED=false
SUPPORT_BOT_SEND_ENABLED=false
SUPPORT_BOT_WORKER_TOKEN=
SUPPORT_BOT_MODEL_ID=gpt-6.1-sol
# Use the provider-supported high reasoning effort and Responses streaming protocol.
# 使用供应商支持的 high 思考等级和 Responses 流式协议。
SUPPORT_BOT_REASONING_EFFORT=high
SUPPORT_BOT_API_PROTOCOL=responses
SUPPORT_BOT_API_BASE_URL=
SUPPORT_BOT_API_KEY=
# Optional Canvas evidence sources: same deployment, SELECT-only database credentials.
# 可选Canvas证据源：必须同环境，只读数据库账号；未配置时明确显示数据/版本缺口。
SUPPORT_BOT_CANVAS_DATABASE_URL=
SUPPORT_BOT_CANVAS_VERSION_URL=
# Optional independent Production Lab read-only DB; falls back to PRODUCTION_LAB_DATABASE_URL, never FG DB.
# 独立 Production Lab 只读业务库；未填时使用 PRODUCTION_LAB_DATABASE_URL，绝不回退 FG 主库。
SUPPORT_BOT_PRODUCTION_LAB_DATABASE_URL=
# Same-environment native endpoints; use /health/version (gateway/agent) or /.well-known/fg-runtime.json (web).
# 同环境独立版本地址；开发态、dirty 或缺少构建证明时不签认线上源码。
SUPPORT_BOT_YINGCE_GATEWAY_VERSION_URL=
SUPPORT_BOT_YINGCE_AGENT_VERSION_URL=
SUPPORT_BOT_YINGCE_WEB_VERSION_URL=
# Prefer read-only mounted JSONL logs; container mode requires an operator-provided Docker CLI/context.
# 优先只读挂载JSONL日志；容器模式需管理员配置Docker CLI/context，不自动开放Docker socket。
# Native evidence must carry matching build_environment: production (local uses development).
# 原生日志必须含匹配的 build_environment：生产为 production，本地为 development；缺失或不匹配不作证据。
SUPPORT_BOT_NATIVE_LOG_SOURCES={}
# Native products use an authenticated Gateway relay, with active account and instance/workspace ownership checks.
# 五产品通过独立只读 Gateway relay，核验 active 账号及实例/workspace 归属；不要指向公网入口。
SUPPORT_BOT_NATIVE_GATEWAY_URL=
# At least 32 random characters; worker, relay and native services only. Never expose to Web clients.
# 至少32位随机字符，仅 worker/relay/原生服务配置，不向浏览器下发，不复用业务密钥。
SUPPORT_BOT_NATIVE_READ_TOKEN=
# Explicit pilot FG UUID for probes. One user's successful probe is not all-user acceptance.
# 预检用真实 FG 账号 UUID；单账号探测通过不代表全部用户验收。
SUPPORT_BOT_NATIVE_PROBE_USER_ID=
# Optional explicit acceptance window (ISO timestamps, <=7 days). The output reports the applied window.
# 可指定本次真实验收时间窗（ISO时间，最长7天），输出保留实际范围；不能据此冒称历史全量覆盖。
SUPPORT_BOT_NATIVE_PROBE_FROM=
SUPPORT_BOT_NATIVE_PROBE_TO=
FEISHU_SUPPORT_APP_ID=
FEISHU_SUPPORT_APP_SECRET=
FEISHU_SUPPORT_VERIFICATION_TOKEN=
FEISHU_SUPPORT_ENCRYPT_KEY=
FEISHU_SUPPORT_BOT_OPEN_ID=
FEISHU_SUPPORT_TENANT_KEY=
# Optional table sync; both values must be configured together.
# 表格同步可选；两个字段必须同时配置。
FEISHU_SUPPORT_BITABLE_APP_TOKEN=
FEISHU_SUPPORT_BITABLE_TABLE_ID=
# Map module names to developer open_id; default is the fallback owner.
# 模块名映射到开发人员 open_id；default 为兜底负责人。
SUPPORT_BOT_MODULE_OWNERS={}
