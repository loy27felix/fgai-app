# FG Studio AI 创作台使用本地 PostgreSQL 与 NAS 媒体服务。
# 将它配置到 .env.local 或 Docker 环境；绝不能加 NEXT_PUBLIC_ 前缀。
DATABASE_URL=postgres://fg_studio:replace-with-password@localhost:5432/fg_studio
NAS_MEDIA_PATH=/Users/zhangyu/work/beva/mnt_nas_fg-studio-media
SESSION_SECRET=replace-with-random-secret

# === Usage cost display ===
# Display-only FX rate; update when your accounting rate changes.
USAGE_USD_TO_CNY_RATE=6.77
