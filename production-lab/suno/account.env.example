# Copy to the server's private-data/suno.private.env. Never commit real values.
# Raw values after '='; do not add shell quotes.
SUNO_COOKIE=
# Reserved for a separately verified CAPTCHA adapter; not used by current transport.
TWOCAPTCHA_KEY=
# Use the company's currently permitted default from /api/billing/info/.
SUNO_MODEL=auto
SUNO_ENABLED=false
