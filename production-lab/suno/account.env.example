# Copy to the server's private-data/suno.private.env. Never commit real values.
# Raw values after '='; do not add shell quotes.
SUNO_COOKIE=
TWOCAPTCHA_KEY=
# This is the upstream library's known default, not a verified Suno v6 ID.
# Change only to a model key verified against the company's current account.
SUNO_MODEL=chirp-v3-5
SUNO_ENABLED=false
