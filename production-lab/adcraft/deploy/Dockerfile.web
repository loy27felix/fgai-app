FROM node:22-alpine AS build
WORKDIR /app
COPY upstream/apps/web/package.json upstream/apps/web/package-lock.json ./
COPY upstream/apps/web/vendor ./vendor
RUN npm ci
COPY upstream/apps/web/ ./
RUN npm run build
RUN npx vitest run src/features/agent-canvas/model/normalizers.test.ts -t "FG workspace media|enforces project asset geometry"
FROM nginx:1.28-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
