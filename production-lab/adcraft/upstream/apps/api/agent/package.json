{
  "name": "@adcraft/pi-agent-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "generate:capabilities": "tsx scripts/generate-agent-capabilities.ts",
    "generate:skills": "tsx scripts/generate-skill-manifest.ts",
    "generate:manifest": "npm run generate:capabilities && tsx scripts/generate-runtime-manifest.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "verify:skills": "tsx scripts/verify-skills.ts",
    "test": "vitest run",
    "test:structured-repair": "tsx --test tests/structured-repair.node-test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "ajv": "^8.17.1",
    "openai": "6.26.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "patch-package": "^8.0.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
